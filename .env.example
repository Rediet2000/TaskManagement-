# --- Initial System Setup ---
# The first superadmin created upon system startup
FIRST_SUPERADMIN_EMAIL=admin@system.com
FIRST_SUPERADMIN_PASSWORD=your_secure_password
FIRST_ALLOWED_DOMAIN=system.com

# --- Database Configuration ---
# Format: postgresql://user:password@host:port/db_name
DATABASE_URL=postgresql://postgres:postgres@db:5432/taskmanagement

# --- Security ---
# Secret key for JWT token generation
SECRET_KEY=generate_a_random_secure_string_here

# --- SMTP Configuration ---
# Used for password resets and system notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM_EMAIL=noreply@example.com

# --- Telegram Integration ---
# (Optional) For automated status updates
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
